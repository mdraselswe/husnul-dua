// Production schema using PostgreSQL (Vercel Postgres / Supabase)
// SQLite does not work on Vercel serverless — see VERCEL-DEPLOYMENT-FIX.md

generator client {
  provider   = "prisma-client"
  output     = "../lib/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dua {
  id            String   @id @default(cuid())
  titleBengali  String
  titleEnglish  String?
  arabic        String?
  transliteration String?
  bengali       String
  english       String?
  tags          String   // Comma-separated tags like "headache,body-pain,any-pain"
  category      String?  // Optional category like "health", "protection", etc.
  source        String?  // Source reference like "Sahih Bukhari"
  times         String?  // When to recite (e.g., "3 times", "after Fajr")
  benefits      String?  // Benefits in Bengali
  // Moderation: public submissions default to "pending" (set in API handler),
  // admin-created / approved are "approved". Column default is "approved" so
  // existing rows stay visible after `prisma db push`.
  status        String   @default("approved") // "pending" | "approved"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tags])
  @@index([category])
  @@index([status])
}


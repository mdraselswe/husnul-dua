// Production schema using PostgreSQL (Vercel Postgres / Supabase)
// SQLite does not work on Vercel serverless — see VERCEL-DEPLOYMENT-FIX.md

generator client {
  provider   = "prisma-client"
  output     = "../lib/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dua {
  id            String   @id @default(cuid())
  titleBengali  String
  titleEnglish  String?
  arabic        String?
  transliteration String?
  bengali       String
  english       String?
  tags          String   // Comma-separated tags like "headache,body-pain,any-pain"
  category      String?  // Optional category like "health", "protection", etc.
  source        String?  // Source reference like "Sahih Bukhari"
  times         String?  // When to recite (e.g., "3 times", "after Fajr")
  benefits      String?  // Benefits in Bengali (ফায়েদা)
  fojilot       String?  // Virtue / merit (ফজিলত)
  rules         String?  // How/when to recite — method (পড়ার নিয়ম)
  context       String?  // Background / context (প্রেক্ষাপট)
  quranRef      String?  // Quran audio ref, e.g. "2:255" or "112:1-4, 113:1-5"
  videoUrl      String?  // Link to a video about the dua's virtue (fojilot)
  articleUrl    String?  // Link to an article about the dua's virtue
  // Extra dua blocks for an amol containing multiple duas. JSON array of
  // { arabic?, transliteration?, bengali?, source? }. Main fields above are
  // dua #1; these are #2, #3, ... Empty/absent = single dua (backward compatible).
  segments      Json?
  // Moderation: public submissions default to "pending" (set in API handler),
  // admin-created / approved are "approved". Column default is "approved" so
  // existing rows stay visible after `prisma db push`.
  status        String   @default("approved") // "pending" | "approved" | "rejected"
  rejectReason  String?  // Admin note when a submission is rejected
  editToken     String?  // Secret for anonymous submitter to view/edit their pending dua
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tags])
  @@index([category])
  @@index([status])
}

